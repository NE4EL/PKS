<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">
    <EditText android:id="@+id/resetPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Новый временный пароль" android:inputType="textPassword" android:maxLength="128" />
    <EditText android:id="@+id/resetPasswordConfirm" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Повторите пароль" android:inputType="textPassword" android:maxLength="128" />
    <TextView android:id="@+id/resetPasswordError" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/danger" android:visibility="gone" />
</LinearLayout>
