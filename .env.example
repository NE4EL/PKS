# Параметры PostgreSQL для docker-compose.yml (БД КР1 для JavaFX-приложения КР2).
# Скопируйте в .env и задайте свой пароль. Файл .env в git не коммитится.
ISP_DB_NAME=isp
ISP_DB_USER=isp_app
ISP_DB_PASSWORD=придумайте_пароль
# Порт на компьютере. 5432 часто занят локальным PostgreSQL, 5433 — демо-системой из архива.
ISP_DB_PORT=55433
