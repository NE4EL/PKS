<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Вкладка «Заявки»: панель действий, блок поиска/фильтров/сортировки, таблица и карточка заявки. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.mirea.ispteam.fx.controller.RequestsController"
            styleClass="tab-content">
    <top>
        <VBox spacing="10">
            <HBox styleClass="toolbar" spacing="8" alignment="CENTER_LEFT">
                <Button text="+ Новая заявка" onAction="#onAdd" styleClass="primary"/>
                <Button fx:id="editButton" text="Изменить" onAction="#onEdit"/>
                <Button fx:id="statusButton" text="Сменить статус" onAction="#onChangeStatus"/>
                <Button fx:id="deleteButton" text="Удалить" onAction="#onDelete" styleClass="danger"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Экспорт в файл…" onAction="#onExport"/>
            </HBox>

            <VBox styleClass="card" spacing="6">
                <Label text="Поиск, фильтры и сортировка" styleClass="card-title"/>
                <FlowPane hgap="12" vgap="8" alignment="BOTTOM_LEFT">
                    <VBox spacing="3">
                        <Label text="Поиск" styleClass="field-label"/>
                        <TextField fx:id="searchField" prefWidth="270"
                                   promptText="ФИО, телефон, описание или тариф"/>
                    </VBox>
                    <VBox spacing="3">
                        <Label text="Статус" styleClass="field-label"/>
                        <ComboBox fx:id="statusFilter" prefWidth="150"/>
                    </VBox>
                    <VBox spacing="3">
                        <Label text="Тип заявки" styleClass="field-label"/>
                        <ComboBox fx:id="typeFilter" prefWidth="185"/>
                    </VBox>
                    <VBox spacing="3">
                        <Label text="Создана с" styleClass="field-label"/>
                        <DatePicker fx:id="fromDate" prefWidth="135" promptText="дд.мм.гггг"/>
                    </VBox>
                    <VBox spacing="3">
                        <Label text="по" styleClass="field-label"/>
                        <DatePicker fx:id="toDate" prefWidth="135" promptText="дд.мм.гггг"/>
                    </VBox>
                    <VBox spacing="3">
                        <Label text="Сортировка" styleClass="field-label"/>
                        <ComboBox fx:id="sortBox" prefWidth="175"/>
                    </VBox>
                    <Button text="Сбросить" onAction="#onResetFilters" styleClass="flat"/>
                </FlowPane>
                <Label fx:id="filterError" styleClass="error-text" visible="false" managed="false"/>
            </VBox>
        </VBox>
    </top>

    <center>
        <SplitPane dividerPositions="0.74" styleClass="content-split">
            <BorderPane.margin>
                <Insets top="10"/>
            </BorderPane.margin>
            <TableView fx:id="table" styleClass="data-table">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="idColumn" text="№" prefWidth="50" minWidth="40" styleClass="col-number"/>
                    <TableColumn fx:id="subscriberColumn" text="Абонент" prefWidth="170" minWidth="120"/>
                    <TableColumn fx:id="phoneColumn" text="Телефон" prefWidth="112" minWidth="105"/>
                    <TableColumn fx:id="typeColumn" text="Тип" prefWidth="150" minWidth="110"/>
                    <TableColumn fx:id="statusColumn" text="Статус" prefWidth="118" minWidth="115"/>
                    <TableColumn fx:id="tariffColumn" text="Тариф" prefWidth="110" minWidth="80"/>
                    <TableColumn fx:id="createdColumn" text="Создана" prefWidth="118" minWidth="115"/>
                    <TableColumn fx:id="descriptionColumn" text="Описание" prefWidth="260" minWidth="160"/>
                </columns>
            </TableView>

            <ScrollPane fitToWidth="true" styleClass="details-scroll" minWidth="280" prefWidth="330"
                        SplitPane.resizableWithParent="false">
                <VBox styleClass="details" spacing="10">
                    <Label text="Карточка заявки" styleClass="card-title"/>
                    <Label fx:id="detailsPlaceholder" wrapText="true" styleClass="muted"
                           text="Выберите заявку в таблице, чтобы увидеть подробности и данные абонента. Двойной щелчок — редактирование."/>
                    <VBox fx:id="detailsContent" spacing="10">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label fx:id="detailNumber" styleClass="details-heading"/>
                            <Label fx:id="detailStatus"/>
                        </HBox>
                        <GridPane hgap="10" vgap="6">
                            <columnConstraints>
                                <ColumnConstraints minWidth="95"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                            <Label text="Тип" styleClass="field-label" GridPane.rowIndex="0"/>
                            <Label fx:id="detailType" wrapText="true" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                            <Label text="Тариф" styleClass="field-label" GridPane.rowIndex="1"/>
                            <Label fx:id="detailTariff" wrapText="true" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            <Label text="Создана" styleClass="field-label" GridPane.rowIndex="2"/>
                            <Label fx:id="detailCreated" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            <Label text="Обновлена" styleClass="field-label" GridPane.rowIndex="3"/>
                            <Label fx:id="detailUpdated" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                            <Label text="Можно перевести в" styleClass="field-label" wrapText="true" GridPane.rowIndex="4"/>
                            <Label fx:id="detailTransitions" wrapText="true" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                        </GridPane>
                        <Label text="Описание" styleClass="field-label"/>
                        <Label fx:id="detailDescription" wrapText="true" styleClass="description-box" maxWidth="Infinity"/>

                        <Separator/>
                        <Label text="Абонент" styleClass="card-title"/>
                        <GridPane hgap="10" vgap="6">
                            <columnConstraints>
                                <ColumnConstraints minWidth="95"/>
                                <ColumnConstraints hgrow="ALWAYS"/>
                            </columnConstraints>
                            <Label text="ФИО" styleClass="field-label" GridPane.rowIndex="0"/>
                            <Label fx:id="detailSubscriber" wrapText="true" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                            <Label text="Телефон" styleClass="field-label" GridPane.rowIndex="1"/>
                            <Label fx:id="detailPhone" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            <Label text="Email" styleClass="field-label" GridPane.rowIndex="2"/>
                            <Label fx:id="detailEmail" wrapText="true" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            <Label text="Адрес" styleClass="field-label" GridPane.rowIndex="3"/>
                            <Label fx:id="detailAddress" wrapText="true" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                            <Label text="Заявок всего" styleClass="field-label" GridPane.rowIndex="4"/>
                            <Label fx:id="detailSubscriberRequests" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                        </GridPane>
                    </VBox>
                </VBox>
            </ScrollPane>
        </SplitPane>
    </center>

    <bottom>
        <HBox styleClass="footer" alignment="CENTER_LEFT">
            <Label fx:id="countLabel" styleClass="muted"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Сортировка: щелчок по заголовку столбца, Shift+щелчок — по нескольким столбцам"
                   styleClass="muted"/>
        </HBox>
    </bottom>
</BorderPane>
