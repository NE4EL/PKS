<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Главное окно. fx:controller — класс-контроллер; fx:id — имя поля в контроллере;
     onAction="#метод" — обработчик события в контроллере. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.mirea.ispteam.fx.controller.MainController"
            styleClass="app-root">
    <top>
        <HBox styleClass="app-header" alignment="CENTER_LEFT" spacing="10">
            <VBox spacing="2">
                <Label text="Учёт заявок интернет-провайдера" styleClass="app-title"/>
                <Label text="Абоненты и их заявки: подключение, смена тарифа, техподдержка, отключение"
                       styleClass="app-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="⟳  Обновить" onAction="#refresh" styleClass="header-button"/>
            <Button text="Статистика" onAction="#onStatistics" styleClass="header-button, header-accent"/>
        </HBox>
    </top>

    <center>
        <TabPane fx:id="tabs" tabClosingPolicy="UNAVAILABLE" styleClass="main-tabs">
            <Tab text="Заявки">
                <fx:include fx:id="requests" source="requests-tab.fxml"/>
            </Tab>
            <Tab text="Абоненты">
                <fx:include fx:id="subscribers" source="subscribers-tab.fxml"/>
            </Tab>
        </TabPane>
    </center>

    <bottom>
        <HBox styleClass="status-bar" alignment="CENTER_LEFT">
            <padding>
                <Insets top="4" right="14" bottom="4" left="14"/>
            </padding>
            <Label fx:id="statusLabel" styleClass="status-text"/>
        </HBox>
    </bottom>
</BorderPane>
