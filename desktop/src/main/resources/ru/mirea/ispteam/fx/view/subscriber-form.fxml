<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Форма добавления/редактирования абонента. Поля со звёздочкой обязательны. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.mirea.ispteam.fx.controller.SubscriberFormController"
      styleClass="form" spacing="14" prefWidth="520">

    <Label text="Данные абонента" styleClass="form-title"/>

    <GridPane hgap="12" vgap="4">
        <columnConstraints>
            <ColumnConstraints minWidth="140"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="ФИО *" styleClass="field-label" GridPane.rowIndex="0"/>
        <TextField fx:id="fullNameField" promptText="Иванов Иван Иванович" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Только буквы, пробел, дефис или апостроф; до 255 символов" styleClass="hint" wrapText="true"
               GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Телефон *" styleClass="field-label" GridPane.rowIndex="2"/>
        <TextField fx:id="phoneField" promptText="+79001234567" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label text="Формат +7XXXXXXXXXX, должен быть уникальным" styleClass="hint" wrapText="true"
               GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Email" styleClass="field-label" GridPane.rowIndex="4"/>
        <TextField fx:id="emailField" promptText="name@example.com" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        <Label text="Необязательно; если указан — уникальный" styleClass="hint" wrapText="true"
               GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <Label text="Адрес *" styleClass="field-label" GridPane.rowIndex="6"/>
        <TextField fx:id="addressField" promptText="г. Москва, ул. Ленина, д. 1, кв. 10"
                   GridPane.rowIndex="6" GridPane.columnIndex="1"/>
        <Label text="До 500 символов" styleClass="hint" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

        <Label text="Дата регистрации" styleClass="field-label" GridPane.rowIndex="8"/>
        <DatePicker fx:id="registrationPicker" promptText="дд.мм.гггг" maxWidth="Infinity"
                    GridPane.rowIndex="8" GridPane.columnIndex="1"/>
        <Label fx:id="registrationHint" styleClass="hint" wrapText="true" GridPane.rowIndex="9" GridPane.columnIndex="1"/>
    </GridPane>

    <Label fx:id="errorLabel" styleClass="form-error" wrapText="true" maxWidth="Infinity"/>

    <HBox spacing="8" alignment="CENTER_RIGHT">
        <Button text="Отмена" onAction="#onCancel" cancelButton="true"/>
        <Button text="Сохранить" onAction="#onSave" defaultButton="true" styleClass="primary"/>
    </HBox>
</VBox>
