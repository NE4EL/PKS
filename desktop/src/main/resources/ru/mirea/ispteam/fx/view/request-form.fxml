<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Форма добавления/редактирования заявки. Поля со звёздочкой обязательны. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ru.mirea.ispteam.fx.controller.RequestFormController"
      styleClass="form" spacing="14" prefWidth="560">

    <Label text="Данные заявки" styleClass="form-title"/>

    <GridPane hgap="12" vgap="4">
        <columnConstraints>
            <ColumnConstraints minWidth="120"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="Абонент *" styleClass="field-label" GridPane.rowIndex="0"/>
        <ComboBox fx:id="subscriberBox" maxWidth="Infinity" promptText="Выберите абонента из списка"
                  GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label text="Нет в списке? Сначала добавьте абонента на вкладке «Абоненты»"
               styleClass="hint" wrapText="true" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Тип заявки *" styleClass="field-label" GridPane.rowIndex="2"/>
        <ComboBox fx:id="typeBox" maxWidth="Infinity" promptText="Выберите тип"
                  GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Region prefHeight="6" GridPane.rowIndex="3"/>

        <Label text="Статус" styleClass="field-label" GridPane.rowIndex="4"/>
        <ComboBox fx:id="statusBox" maxWidth="Infinity" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
        <Label fx:id="statusHint" styleClass="hint" wrapText="true" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

        <Label text="Тарифный план" styleClass="field-label" GridPane.rowIndex="6"/>
        <TextField fx:id="tariffField" GridPane.rowIndex="6" GridPane.columnIndex="1"/>
        <Label fx:id="tariffHint" styleClass="hint" wrapText="true" GridPane.rowIndex="7" GridPane.columnIndex="1"/>

        <Label text="Описание *" styleClass="field-label" GridPane.rowIndex="8" GridPane.valignment="TOP"/>
        <TextArea fx:id="descriptionArea" wrapText="true" prefRowCount="5"
                  promptText="Что нужно сделать по заявке"
                  GridPane.rowIndex="8" GridPane.columnIndex="1"/>
        <Label fx:id="descriptionCounter" styleClass="hint" GridPane.rowIndex="9" GridPane.columnIndex="1"/>
    </GridPane>

    <Label fx:id="errorLabel" styleClass="form-error" wrapText="true" maxWidth="Infinity"/>

    <HBox spacing="8" alignment="CENTER_RIGHT">
        <Button text="Отмена" onAction="#onCancel" cancelButton="true"/>
        <Button text="Сохранить" onAction="#onSave" defaultButton="true" styleClass="primary"/>
    </HBox>
</VBox>
